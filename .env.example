NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
POSTGRES_PORT=55432
REDIS_PORT=6379
DATABASE_URL=postgresql://cc_app:cc_dev_password@localhost:55432/cc_tracker
TEST_DATABASE_URL=postgresql://cc_app:cc_dev_password@localhost:55432/cc_tracker_test
REDIS_URL=redis://localhost:6379
API_DB_POOL_MAX=5
WORKER_DB_POOL_MAX=3
SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
# Required for the protected /api/metrics endpoint in production.
METRICS_TOKEN=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Set a strong value locally; never commit a real password.
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-use
BOOTSTRAP_ADMIN_NAME=System Administrator
# Local-only destructive reset credentials used by `npm run seed:dev`.
DEV_ADMIN_EMAIL=admin@mrtee.vn
DEV_ADMIN_PASSWORD=change-this-before-use
DEV_ADMIN_NAME=Quản trị viên
CF_API_BASE_URL=https://codeforces.com/api
CF_REQUEST_INTERVAL_MS=2200
CF_REQUEST_TIMEOUT_MS=10000
CF_REQUEST_MAX_ATTEMPTS=4
BACKFILL_PAGE_SIZE=1000
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_BATCH_SIZE=25
SYNC_ONLINE_TARGET_MINUTES=15
SYNC_RECENT_TARGET_MINUTES=30
SYNC_OFFLINE_TARGET_MINUTES=1440
SYNC_CAPACITY_RESERVE_PERCENT=0.25
VITE_API_BASE_URL=/api

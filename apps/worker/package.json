{
  "name": "@cc/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "ioredis": "^5.7.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "vitest": "^4.1.10"
  }
}

{
  "name": "cc-mrtee-codeforces-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Codeforces Gamification Tracker modular monolith",
  "license": "UNLICENSED",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @cc/web",
    "dev:api": "npm run dev --workspace @cc/api",
    "dev:worker": "npm run dev --workspace @cc/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @cc/database",
    "db:migrate": "npm run db:migrate --workspace @cc/database",
    "db:check": "npm run db:check --workspace @cc/database",
    "seed:dev": "npm run seed:dev --workspace @cc/api",
    "load:smoke": "node scripts/load-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
